# coach-engine: every value the workflows reference as a {{PLACEHOLDER}}.
# Nothing here is read by n8n directly. It documents what you need to provision
# and what to substitute into the workflow JSON before importing.

# --- Supabase (source of truth) -------------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://${SUPABASE_PROJECT_REF}.supabase.co
# n8n's Supabase credential needs the legacy service_role JWT (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n (self-hosted) -----------------------------------------------------
N8N_EDITOR_URL=https://n8n.example.com
# Production webhooks are served on a separate hostname in the original setup.
N8N_WEBHOOK_BASE_URL=https://hooks.example.com
# Credential ids are assigned by n8n when you create each credential; paste
# them into the workflow JSON (or let n8n re-map on import).
CRED_SUPABASE_ID=
CRED_ANTHROPIC_ID=
CRED_OPENAI_ID=
CRED_TELEGRAM_ID=

# --- Telegram ------------------------------------------------------------
# Bot token from @BotFather goes in the n8n Telegram credential, never here.
TELEGRAM_CHAT_ID=            # your own chat id; the bot is locked to it

# --- Models --------------------------------------------------------------
ANTHROPIC_API_KEY=           # in the n8n Anthropic credential
OPENAI_API_KEY=              # in the n8n OpenAI credential (Whisper transcription only)

# --- Withings (scale) ----------------------------------------------------
# client_id / client_secret live in the `integrations` table, not in n8n.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# --- Programme -----------------------------------------------------------
DEFAULT_GYM=                 # name used when a workout note does not say where
PHASE_TARGET_KG=             # phase target weight; in the live system this is a programme key
