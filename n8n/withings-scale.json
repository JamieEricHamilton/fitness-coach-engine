    {
      "id": "aa9761cb-fc58-4f81-9c3b-007e61f08485",
      "name": "Process weigh-ins",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        500
      ],
      "parameters": {
        "jsCode": "// n8n Code node: Process weigh-ins\n// Inputs: Fetch measures (Withings getmeas), Read weigh_ins (recent raw readings), Read daily (recent daily rows).\n// Output: one item per NEW reading date with weighInRows, dailyRow and the Telegram reply; nothing if no new readings.\n// weigh_ins.ignored = true marks test or wrong readings: they still count as known (never re-logged) but never set a day's weight.\nconst res = $('Fetch measures').first().json || {};\nlet known = [], daily = [];\ntry { known = $('Read weigh_ins').all().map(i => i.json).filter(r => r.grpid != null); } catch (e) {}\ntry { daily = $('Read daily').all().map(i => i.json).filter(r => r.date && r.weight_kg != null); } catch (e) {}\nconst tc = $('Token check').first().json || {};\nconst fatalItem = msg => [{ json: { fatal: msg, reply: `⚠️ Withings weigh-in not logged: ${msg}`, weighInRows: [], dailyRow: null } }];\nif (tc.fatal) return fatalItem(tc.fatal);\nif (res.status !== 0) return fatalItem(`getmeas failed, status ${res.status} ${res.error || ''}`);\nconst grps = (res.body && res.body.measuregrps) || [];\nconst knownIds = new Set(known.map(r => String(r.grpid)));\nconst readings = [];\nfor (const g of grps) {\n  if (g.category !== 1) continue;                       // 1 = real measure, 2 = user objective\n  if (g.attrib === 2 || g.attrib === 4) continue;         // manual entries (profile weight typed into the app), not the scale\n  const m = (g.measures || []).find(x => x.type === 1);  // type 1 = weight\n  if (!m) continue;\n  const kg = Math.round(m.value * Math.pow(10, m.unit) * 100) / 100;\n  if (kg < 40 || kg > 150) continue;                    // not the user (guest / pet / box)\n  const dt = DateTime.fromSeconds(g.date).setZone('Europe/London');\n  readings.push({ grpid: g.grpid, measured_at: dt.toUTC().toISO(), date: dt.toISODate(), weight_kg: kg, source: 'withings', isNew: !knownIds.has(String(g.grpid)) });\n}\nconst fresh = readings.filter(r => r.isNew);\nif (!fresh.length) return [];\n\nconst TARGET = Number('{{PHASE_TARGET_KG}}');   // phase target: in the real system this is a programme key\nconst num = v => parseFloat(v) || 0;\nconst avg = a => a.length ? a.reduce((x, y) => x + y, 0) / a.length : null;\nconst out = [];\nconst dates = [...new Set(fresh.map(r => r.date))].sort();\nfor (const date of dates) {\n  // the day's weight = earliest reading that day (the fasted one), across stored (not ignored) and new readings\n  const dayReads = known.filter(r => r.date === date && !r.ignored).map(r => ({ measured_at: r.measured_at, weight_kg: num(r.weight_kg) }))\n    .concat(readings.filter(r => r.date === date).map(r => ({ measured_at: r.measured_at, weight_kg: r.weight_kg })));\n  dayReads.sort((a, b) => a.measured_at < b.measured_at ? -1 : 1);\n  const weight = dayReads[0].weight_kg;\n  const d = DateTime.fromISO(date);\n  const inRange = (from, to) => daily.filter(r => r.date >= from && r.date <= to && r.date !== date).map(r => num(r.weight_kg));\n  const thisWeek = inRange(d.minus({ days: 6 }).toISODate(), date).concat([weight]);\n  const lastWeek = inRange(d.minus({ days: 13 }).toISODate(), d.minus({ days: 7 }).toISODate());\n  const a1 = avg(thisWeek), a0 = avg(lastWeek);\n  let trend;\n  if (a0 != null) trend = `7-day avg ${a1.toFixed(1)}kg, ${(a1 - a0) >= 0 ? '+' : ''}${(a1 - a0).toFixed(1)}kg vs last week.`;\n  else trend = `7-day avg ${a1.toFixed(1)}kg (${thisWeek.length} reading${thisWeek.length > 1 ? 's' : ''}).`;\n  const extra = dayReads.length > 1 ? ` (${dayReads.length} readings today, first one kept)` : '';\n  const reply = `⚖️ ${weight}kg from the scale, logged for ${d.toFormat('d MMM')}${extra}.\\n${trend}\\n${(a1 - TARGET).toFixed(1)}kg above the ${TARGET}kg target.`;\n  out.push({ json: {\n    date, weight_kg: weight, reply,\n    weighInRows: fresh.filter(r => r.date === date).map(({ isNew, ...r }) => r),\n    dailyRow: { date, weight_kg: weight, weight_7d_avg: Math.round(a1 * 100) / 100, weight_source: 'withings' },\n  } });\n}\nreturn out;\n"
      }
    },
