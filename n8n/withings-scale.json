      "parameters": {
        "jsCode": "// n8n Code node: Coach text W\nconst j = $input.first().json || {};\nif (j.skip || j.error) return [];\nconst text = (j.content || []).filter(c => c.type === 'text').map(c => c.text).join('\\n').trim();\nif (!text || /^NONE\\.?$/i.test(text)) return [];\nreturn [{ json: { text } }];\n"
      }
