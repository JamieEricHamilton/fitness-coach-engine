    {
      "id": "f816e774-8fbd-4209-98d9-dc20f370dae3",
      "name": "Connected text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "// n8n Code node: Connected text\nconst t = $('Save tokens').first().json || {};\nconst sub = $input.first().json || {};\nif (!t.ok) return [{ json: { html: `<h2>Withings: not connected</h2><p>${t.error}</p><p>Try the authorise link again (the code only lives 30 seconds).</p>`, tg: `⚠️ Withings connection failed: ${t.error}` } }];\nconst subOk = sub.status === 0;\nconst html = `<h2>Withings connected ✅</h2><p>User ${t.external_user_id}. Notification subscription: ${subOk ? 'active' : 'FAILED (status ' + sub.status + ' ' + (sub.error || '') + ')'}.</p><p>Step on the scale: the reading should arrive in Telegram within a minute or two.</p>`;\nconst tg = subOk ? `⚖️ Withings scale connected. Weigh-ins now land here automatically.` : `⚠️ Withings tokens saved but the notification subscription failed (status ${sub.status} ${sub.error || ''}). Ask Claude to re-run the subscribe step.`;\nreturn [{ json: { html, tg } }];\n"
      }
    },
