              "name": "client_id",
              "value": "={{ $json.client_id }}"
            },
            {
              "name": "client_secret",
              "value": "={{ $json.client_secret }}"
            },
            {
              "name": "grant_type",
              "value": "authorization_code"
            },
            {
              "name": "code",
              "value": "={{ $('Withings OAuth callback').first().json.query.code }}"
            },
            {
              "name": "redirect_uri",
              "value": "{{N8N_WEBHOOK_BASE_URL}}/webhook/withings/callback"
