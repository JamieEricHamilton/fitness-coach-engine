    {
      "id": "e810e2cb-6191-45e0-ae1e-fab738043777",
      "name": "Token check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        500
      ],
      "parameters": {
        "jsCode": "// n8n Code node: Token check\n// Input: Read integration W (one row). Output: one item with tokens, whether a refresh is needed, and the getmeas window.\n// Runs from the Withings push (window from the notification) or from the 09:45 safety poll (window = last 3 days).\nconst row = $input.first().json || {};\nlet body = {};\ntry { body = ($('Withings notify').first().json || {}).body || {}; } catch (e) { body = {}; }\nconst now = Math.floor(Date.now() / 1000);\nconst startdate = Number(body.startdate) || (now - 3 * 86400);\nconst enddate = Number(body.enddate) || now;\nif (!row.access_token) return [{ json: { fatal: 'Withings is not connected yet (no tokens in integrations). Open the authorise link first.' } }];\nconst exp = row.expires_at ? Math.floor(new Date(row.expires_at).getTime() / 1000) : 0;\nconst needRefresh = exp - now < 120;\nreturn [{ json: {\n  needRefresh,\n  access_token: row.access_token,\n  refresh_token: row.refresh_token,\n  client_id: row.client_id,\n  client_secret: row.client_secret,\n  meta: row.meta || {},\n  startdate, enddate,\n  withings_userid: String(body.userid || row.external_user_id || ''),\n} }];\n"
      }
    },
    {
      "id": "ef040a22-d32c-4d5f-9c0c-bc14012313bc",
      "name": "Needs refresh",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        500
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.needRefresh }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": true
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "8fa44ddf-549a-4ee7-8c1f-7dd6b40f17e9",
      "name": "Refresh token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://wbsapi.withings.net/v2/oauth2",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "requesttoken"
            },
            {
              "name": "client_id",
              "value": "={{ $json.client_id }}"
            },
            {
              "name": "client_secret",
              "value": "={{ $json.client_secret }}"
            },
            {
              "name": "grant_type",
              "value": "refresh_token"
            },
            {
              "name": "refresh_token",
              "value": "={{ $json.refresh_token }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
