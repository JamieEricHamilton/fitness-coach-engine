              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.ok ? JSON.stringify([{ provider: $json.provider, access_token: $json.access_token, refresh_token: $json.refresh_token, expires_at: $json.expires_at, external_user_id: $json.external_user_id, callback_url: $json.callback_url, meta: $json.meta, updated_at: $json.updated_at }]) : '[]' }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "{{CRED_SUPABASE_ID}}",
          "name": "Supabase (coach-engine)"
        }
      }
    },
    {
