    {
      "id": "b3c8a249-91a8-4659-86e9-ec0782dd7a89",
      "name": "Read daily",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        500
      ],
      "parameters": {
        "url": "{{SUPABASE_URL}}/rest/v1/daily",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "date,weight_kg"
            },
            {
              "name": "order",
              "value": "date.desc"
            },
            {
              "name": "limit",
              "value": "60"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "{{CRED_SUPABASE_ID}}",
