        "jsonBody": "={{ $json.fatal ? '[]' : JSON.stringify([{ provider: 'withings', access_token: $json.access_token, refresh_token: $json.refresh_token, expires_at: $json.expires_at, external_user_id: $json.external_user_id, updated_at: $json.updated_at }]) }}",
        "options": {
