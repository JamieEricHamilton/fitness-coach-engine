    {
      "id": "d667fb0b-5227-4905-abd5-df209c02d8f6",
      "name": "Build coach request W",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        560
      ],
      "parameters": {
        "jsCode": "// n8n Code node: Build coach request W\n// Input: Coach context W (coach_context('weight')). Output: { body } for the Anthropic Messages API (light tier, same as the bot's weigh-in coach line).\nconst ctx = $input.first().json || {};\nconst ev = $('Process weigh-ins').item.json || {};\nif (!ctx.charter || ev.fatal) return [];\nconst { charter, ...facts } = ctx;\nconst now = DateTime.now().setZone('Europe/London');\nconst rules = `## How you are being used right now\nYou are the coach line in the user's Telegram fitness bot. His Withings scale just sent today's fasted weigh-in automatically and the bot has already sent this confirmation:\n\"${ev.reply}\"\nAdd the coach's reaction, or reply exactly NONE if there is nothing worth adding.\n\nRules:\n- Never repeat the confirmation's numbers. Judge the trend (weight_trend) against the phase target in programme; one reading is noise, the 7-day average is the signal. Creatine water context while it applies (while a supplement change applies).\n- Only numbers from the facts. Never invent or estimate.\n- Layout per the charter's Tone and format section: one point per line, short lines, emoji marker at the start, plain text, no markdown. 1-4 short lines.\n- British English, hyphens never em dashes.\n- No adjustment proposals unless the trend has been off for a week, per the charter; the morning digest is where adjustments live.`;\nconst user = `Weigh-in landed ${now.toFormat('cccc d MMMM yyyy, HH:mm')} Europe/London.\\n\\nFacts:\\n${JSON.stringify(facts)}`;\nconst body = {\n  model: 'claude-sonnet-5-5',\n  max_tokens: 2000,\n  thinking: { type: 'adaptive' },\n  output_config: { effort: 'low' },\n  system: [\n    { type: 'text', text: charter, cache_control: { type: 'ephemeral' } },\n    { type: 'text', text: rules },\n  ],\n  messages: [{ role: 'user', content: user }],\n};\nreturn [{ json: { body } }];\n"
      }
    },
