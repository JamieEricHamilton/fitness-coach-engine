      "onError": "continueRegularOutput"
    },
    {
      "id": "36e21cfd-ea61-4067-90ca-dd923bd49b77",
      "name": "Save refreshed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        400
      ],
      "parameters": {
        "jsCode": "// n8n Code node: Save refreshed\n// Input: Withings requesttoken response (refresh_token grant). Output: row for the upsert, carrying access_token forward.\nconst res = $input.first().json || {};\nconst prev = $('Token check').first().json || {};\nif (res.status !== 0 || !res.body || !res.body.access_token) {\n  return [{ json: { fatal: `Withings token refresh failed: status ${res.status} ${res.error || ''}. Re-authorise via the callback link.`, access_token: prev.access_token } }];\n}\nconst b = res.body;\nreturn [{ json: {\n  provider: 'withings',\n  access_token: b.access_token,\n  refresh_token: b.refresh_token,\n  expires_at: new Date(Date.now() + (Number(b.expires_in || 10800) - 120) * 1000).toISOString(),\n  external_user_id: String(b.userid || ''),\n  updated_at: new Date().toISOString(),\n  startdate: prev.startdate, enddate: prev.enddate,\n} }];\n"
      }
    },
    {
      "id": "3101e1fc-131b-42d5-9f1c-0162fe54d2f1",
      "name": "Fetch measures",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
