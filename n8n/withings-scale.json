    {
      "id": "31694523-8218-4015-a234-ba34872fc6aa",
      "name": "Save tokens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "// n8n Code node: Save tokens\n// Input: Withings requesttoken response (authorization_code grant). Output: the integrations row to upsert, plus access_token.\nconst cfg = $('Read integration').first().json || {};\nconst res = $input.first().json || {};\nconst REDIRECT = '{{N8N_WEBHOOK_BASE_URL}}/webhook/withings/callback';\nconst NOTIFY = '{{N8N_WEBHOOK_BASE_URL}}/webhook/withings/notify';\nif (res.status !== 0 || !res.body || !res.body.access_token) {\n  return [{ json: { ok: false, error: `Withings token exchange failed: status ${res.status} ${res.error || ''}`.trim(), access_token: null } }];\n}\nconst b = res.body;\nconst expiresAt = new Date(Date.now() + (Number(b.expires_in || 10800) - 120) * 1000).toISOString();\nreturn [{ json: {\n  ok: true,\n  provider: 'withings',\n  access_token: b.access_token,\n  refresh_token: b.refresh_token,\n  expires_at: expiresAt,\n  external_user_id: String(b.userid || ''),\n  callback_url: REDIRECT,\n  meta: Object.assign({}, cfg.meta || {}, { notify_url: NOTIFY, scope: b.scope, connected_at: new Date().toISOString() }),\n  updated_at: new Date().toISOString(),\n} }];\n"
      }
    },
    {
      "id": "ed35384a-c5e6-4af1-bae3-7f24324da8bb",
      "name": "Upsert integration",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "{{SUPABASE_URL}}/rest/v1/integrations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
