      "name": "Read integration W",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        500
      ],
      "parameters": {
        "url": "{{SUPABASE_URL}}/rest/v1/integrations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "provider",
              "value": "eq.withings"
            },
            {
              "name": "select",
